# Bernhard Riepl Stiftung – Umgebungsvariablen
# Lokal: nach .env.local kopieren und ausfüllen. Niemals echte Werte ins Repository einchecken.
# Auf Vercel setzt die Supabase-Integration diese Variablen automatisch.

# --- Supabase (Region Frankfurt / eu-central-1) ---
# Project Settings → API Keys. Öffentlich – Zugriffe sind durch Row Level Security geschützt.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Geheim, nur für Server-Code (Mailprotokoll, Absage speichern). Nie mit NEXT_PUBLIC_ versehen!
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- E-Mail-Versand über das Postfach der Stiftung (Phase 4) ---
# Anbieterneutral (IONOS, hosting.de, …). Für Tests auf ein Test-Postfach zeigen lassen:
#   Mailpit lokal:  SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_SECURE=false  (SMTP_USER/PASSWORD leer)
#   Ethereal:       SMTP_HOST=smtp.ethereal.email  SMTP_PORT=587  SMTP_SECURE=false  + Zugangsdaten von ethereal.email
SMTP_HOST=<smtp.server.de>
SMTP_PORT=587
# true = SSL/TLS (meist Port 465), false = STARTTLS (meist Port 587)
SMTP_SECURE=false
SMTP_USER=<postfach@stiftungs-domain.de>
SMTP_PASSWORD=<passwort>
# Absenderadresse (der Anzeigename „Bernhard Riepl Stiftung“ wird automatisch ergänzt)
MAIL_FROM=<postfach@stiftungs-domain.de>
# Empfänger der Benachrichtigung über neue Anträge (mehrere mit Komma trennen)
MAIL_STIFTUNGSRAT=<stiftungsrat@stiftungs-domain.de>
# Blindkopie jeder Absage (Archiv im Stiftungspostfach)
MAIL_BCC_ARCHIV=<postfach@stiftungs-domain.de>

# --- Allgemein ---
# Basis für Links in E-Mails. Produktion: https://brstiftung.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
