# Bernhard Riepl Stiftung – Umgebungsvariablen
# Kopieren nach .env.local und ausfüllen. Niemals echte Werte ins Repository einchecken.

# --- Supabase (Phase 2, Region Frankfurt / eu-central-1) ---
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<oeffentlicher-anon-schluessel>
SUPABASE_SERVICE_ROLE_KEY=<geheimer-service-role-schluessel>
# Bucket für Antragsdokumente
SUPABASE_STORAGE_BUCKET=antragsdokumente

# --- E-Mail-Versand über das Stiftungspostfach (Phase 4) ---
SMTP_HOST=<smtp.server.de>
SMTP_PORT=587
SMTP_USER=<benutzername>
SMTP_PASSWORD=<passwort>
SMTP_FROM="Bernhard Riepl Stiftung <info@beispiel-domain.de>"
STIFTUNGSRAT_EMAIL=<stiftungsrat@beispiel-domain.de>

# --- Allgemein ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
